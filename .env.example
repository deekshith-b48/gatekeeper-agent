# --- Owner (seeded into the DB once, then editable there) ---
OWNER_HANDLE=owner
OWNER_NAME=Sam
OWNER_EMAIL=
OWNER_TIMEZONE=Asia/Kolkata
OWNER_WORK_START=09:00
OWNER_WORK_END=18:00
OWNER_MIN_START=11:00
OWNER_MAX_MEETING_MIN=30
OWNER_BUFFER_MIN=10
OWNER_WORK_DAYS=0,1,2,3,4
# comma-separated verified contact ids (phone/email/device), NOT spoken names
OWNER_VIP_CONTACTS=

# --- Calendar: google | caldav ---
CALENDAR_PROVIDER=google
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_CALENDAR_ID=primary
CALDAV_URL=http://localhost:5232
CALDAV_USER=
CALDAV_PASSWORD=
CALDAV_CALENDAR=

# --- LLM / guard (Ollama) ---
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_FALLBACK_MODEL=qwen2.5:3b
GUARD_ENABLED=true
GUARD_MODEL=llama-guard3:1b

# --- Voice ---
WHISPER_MODEL=base
PIPER_VOICE=en_US-lessac-medium
STT_PARTIALS=false

# --- Notifications (https://ntfy.sh/<topic>; pick an unguessable topic) ---
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# --- Security (empty ADMIN_TOKEN disables admin REST; set CALL_TOKEN when exposed beyond localhost) ---
ADMIN_TOKEN=
CALL_TOKEN=
DATABASE_URL=sqlite:///data/gatekeeper.db
