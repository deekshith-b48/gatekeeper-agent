# --- Owner (seeded into the DB once, then editable there) ---
OWNER_HANDLE=owner
OWNER_NAME=Sam
OWNER_EMAIL=
OWNER_TIMEZONE=Asia/Kolkata
OWNER_WORK_START=09:00
OWNER_WORK_END=18:00
OWNER_MIN_START=11:00
OWNER_MAX_MEETING_MIN=30
OWNER_BUFFER_MIN=10
OWNER_WORK_DAYS=0,1,2,3,4
# comma-separated verified contact ids (phone/email/device), NOT spoken names
OWNER_VIP_CONTACTS=

# --- Calendar: google | caldav ---
CALENDAR_PROVIDER=google
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_CALENDAR_ID=primary
CALDAV_URL=http://localhost:5232
CALDAV_USER=
CALDAV_PASSWORD=
CALDAV_CALENDAR=

# --- LLM / guard ---
# LIGHT MODE (recommended, ~0 GB models): a free hosted OpenAI-compatible API. Get a free key from Groq, Google AI Studio (Gemini) or OpenRouter.
#   Verify model names + free-tier limits on the provider's site; they change. Example (Groq):
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
# LOCAL MODE (private, 2-6 GB): LLM_PROVIDER=ollama and the three model names below.
OLLAMA_URL=http://localhost:11434
# Model names: for provider=openai use the provider's ids (e.g. Groq: llama-3.3-70b-versatile / llama-3.1-8b-instant)
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
# Hosted guard model optional; the rule-based guard and code-level tool gating always run.
GUARD_ENABLED=false
GUARD_MODEL=llama-guard3:1b

# --- Voice ---
WHISPER_MODEL=base
PIPER_VOICE=en_US-lessac-medium
STT_PARTIALS=false

# --- Notifications (https://ntfy.sh/<topic>; pick an unguessable topic) ---
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# --- Security (empty ADMIN_TOKEN disables admin REST; set CALL_TOKEN when exposed beyond localhost) ---
ADMIN_TOKEN=
CALL_TOKEN=
DATABASE_URL=sqlite:///data/gatekeeper.db
